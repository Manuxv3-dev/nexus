# Nexus — variables d'environnement (exemple)
# Copier en `.env` à la racine et remplir.
# `.env` est gitignored.

# --- Général ---
NODE_ENV=development
LOG_LEVEL=info

# --- Backend ---
BACKEND_PORT=3000
BACKEND_HOST=127.0.0.1

# --- PostgreSQL (cf. docker-compose.dev.yml) ---
DATABASE_URL=postgres://nexus:nexus_dev_password@127.0.0.1:5432/nexus_dev

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (cf. ADR-004) ---
JWT_ACCESS_SECRET=change_me_in_production_at_least_32_chars
JWT_REFRESH_SECRET=change_me_in_production_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Anthropic (Claude) — cf. skill use-claude-api ---
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5

# --- URLs publiques ---
# URL publique du frontend (utilisée dans les liens partagés des killer features
# /e/<slug> /p/<slug> /d/<slug> /t/<slug> /l/<slug> et le redirect post-login).
WEB_BASE_URL=http://127.0.0.1:5173

# --- Web Push / VAPID (cf. MAN-142, phase 1 « notifications push PWA ») ---
# Paire de clés VAPID utilisée pour l'abonnement Web Push (GET
# /api/v1/push/vapid-public-key) et, en phase suivante, la signature des
# payloads envoyés via `web-push`. Générer avec :
#   pnpm --filter @nexus/backend exec web-push generate-vapid-keys
# (ou `node -e "console.log(require('web-push').generateVAPIDKeys())"`)
# VAPID_PRIVATE_KEY ne doit jamais quitter le serveur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Email transactionnel / Resend (cf. MAN-171 phase 1, MAN-166 « mot de
# passe oublié — reset complet ») ---
# Clé API Resend (https://resend.com/api-keys) et adresse d'expédition des
# emails transactionnels (doit correspondre à un domaine vérifié côté
# Resend, ex: "Nexus <noreply@nexusapp.chat>"). `core/email.ts` throw une
# AppError explicite si l'une des deux manque au moment d'envoyer un email.
RESEND_API_KEY=
EMAIL_FROM=

# --- Notes post-ADR-027 ---
# Depuis l'universalisation webview messaging, plus aucune var d'env n'est
# requise pour les bridges (Discord, WhatsApp, Messenger, Telegram, etc.).
# Toute l'auth des messageries se fait dans la webview Tauri côté client.
# Variables historiques retirées : ENCRYPTION_KEY_BRIDGES, PROVIDER_SESSIONS_KEY,
# DISCORD_*, MATRIX_*. Si elles traînent dans ton .env, tu peux les supprimer.
