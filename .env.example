# Nexus — variables d'environnement (exemple)
# Copier en `.env` à la racine et remplir.
# `.env` est gitignored.

# --- Général ---
NODE_ENV=development
LOG_LEVEL=info

# --- Backend ---
BACKEND_PORT=3000
BACKEND_HOST=127.0.0.1

# --- PostgreSQL (cf. docker-compose.dev.yml) ---
DATABASE_URL=postgres://nexus:nexus_dev_password@127.0.0.1:5432/nexus_dev

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (cf. ADR-004) ---
JWT_ACCESS_SECRET=change_me_in_production_at_least_32_chars
JWT_REFRESH_SECRET=change_me_in_production_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Sessions bridges (cf. ADR-009, J3a) ---
# Clé AES-256-GCM pour chiffrer les credentials des sessions messageries.
# Format : base64 d'un buffer 32 bytes.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT : sauvegarder cette clé dans un coffre sécurisé (1Password, KeePass).
# Perdre la clé = sessions bridges illisibles. Ne jamais committer cette valeur.
# En prod, générer une clé DIFFÉRENTE de celle de dev.
ENCRYPTION_KEY_BRIDGES=

# Legacy (placeholder pré-J3a, conservé pour rétro-compat env validation)
PROVIDER_SESSIONS_KEY=

# --- Anthropic (Claude) — cf. skill use-claude-api ---
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5

# --- Discord (cf. ADR-006, J3b) ---
# Application créée sur https://discord.com/developers/applications
# Le bot doit avoir : Message Content Intent + Server Members Intent activés.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bitfield des permissions du bot (calculer via le portail Discord developer)
DISCORD_BOT_PERMISSIONS=274877975552
# URL publique de Nexus pour le redirect_uri OAuth Discord
PUBLIC_BASE_URL=http://127.0.0.1:3000

# --- WhatsApp / Baileys (cf. ADR-008) — pas de clé API, sessions multi-device en DB ---
# Rien à configurer ici, la session est créée au pairing QR

# --- Messenger / mautrix-meta + Conduit (cf. ADR-007) ---
MATRIX_HOMESERVER_URL=http://127.0.0.1:6167
MATRIX_AS_TOKEN=
MATRIX_HS_TOKEN=
WEB_BASE_URL=http://127.0.0.1:5173
