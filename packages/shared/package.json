{
  "name": "@nexus/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --tsBuildInfoFile ./tsconfig.typecheck.tsbuildinfo",
    "clean": "rm -rf dist *.tsbuildinfo .turbo"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
