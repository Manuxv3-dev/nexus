{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "version": "0.1.0",
  "identifier": "chat.nexusapp.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @nexus/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @nexus/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus",
        "width": 1280,
        "height": 960,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Nexus — agrégateur de messageries",
    "longDescription": "Nexus rassemble tes messageries dans une seule app, avec une couche d'organisation pour bandes d'amis (events, sondages, dépenses, todos)."
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Manuxv3-dev/nexus/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCM0U0NzEwOTc0MzlFNTgKUldSWW5rT1hFRWMrMnlXR1MxdUV1VDIxZlVrVjhkTldISjEydXdZRHM4OUNaZkw0ZmtleUxwTWcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
