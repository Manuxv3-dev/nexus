{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Explicite plutôt que le défaut TS : sans ça, `tsc` (build) et
    // `tsc --noEmit` (typecheck, cf. package.json) partagent le même
    // cache incrémental — `tsc` peut alors croire `dist/` à jour et ne
    // rien réémettre après un `rm -rf dist` manuel (MAN-90). Nichée dans
    // `dist/`, ce cache est naturellement invalidée par toute suppression
    // du dossier de sortie.
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*"]
}
