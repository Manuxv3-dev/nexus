{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../web/src/*"],
      "@web/*": ["../web/src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "../web/src/**/*"]
}
