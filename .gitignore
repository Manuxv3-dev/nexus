# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Tauri — Cargo.lock est committé (crate binaire, cf. ticket `ad86c777`) :
# seul target/ (artefacts de build) reste ignoré.
src-tauri/target/

# Environment
.env
.env.local
.env.*.local
.env.production
!.env.example
!*.env.example
!**/.env.production.example

# Infra secrets (Docker secrets sur le VPS, jamais commités)
infra/secrets/*
!infra/secrets/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Claude Code — les worktrees sont des copies complètes du dépôt, jamais
# commitées ; settings.local.json est propre à la machine.
.claude/worktrees/
.claude/settings.local.json

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tests
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Drizzle
packages/backend/drizzle/.snapshots/

# Tauri target locale
.tauri/

# Misc
.cache/
.design_extracted/
nexus_design.zip

# Sandbox dev cross-mount artefacts (Cowork mode / WSL)
_tmp_*
