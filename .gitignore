# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Tauri
src-tauri/target/
src-tauri/Cargo.lock

# Environment
.env
.env.local
.env.*.local
.env.production
!.env.example
!*.env.example
!**/.env.production.example

# Infra secrets (Docker secrets sur le VPS, jamais commités)
infra/secrets/*
!infra/secrets/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Claude Code — les worktrees sont des copies complètes du dépôt, jamais
# commitées ; settings.local.json est propre à la machine.
.claude/worktrees/
.claude/settings.local.json

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tests
coverage/
.nyc_output/

# Drizzle
packages/backend/drizzle/.snapshots/

# Tauri target locale
.tauri/

# Misc
.cache/
.design_extracted/
nexus_design.zip

# Sandbox dev cross-mount artefacts (Cowork mode / WSL)
_tmp_*

# Open Graph fonts (téléchargées via `pnpm --filter @nexus/backend setup:fonts`,
# cf. ADR-018). Hors repo pour ne pas alourdir, licence SIL OFL.
packages/backend/assets/fonts/Inter.ttf
!packages/backend/assets/fonts/.gitkeep
