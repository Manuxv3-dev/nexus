# Template pour /opt/nexus/.env.production sur le VPS.
#
# Procédure :
#   1. Sur le VPS : `cp /opt/nexus/.env.production.example /opt/nexus/.env.production`
#   2. `chmod 0600 /opt/nexus/.env.production` (lisible uniquement par le user nexus)
#   3. Remplir les valeurs (générer les secrets, jamais réutiliser ceux de dev)
#   4. Ne JAMAIS commiter ce fichier rempli.
#
# Génération des secrets (côté VPS ou ta machine) :
#   - JWT secrets : `openssl rand -base64 48` (génère 64 chars utilisables)
#   - Postgres password : `openssl rand -base64 32` (mettre dans secrets/pg_password aussi)
#
# ⚠️ Postgres password — duplication consciente :
#   - `secrets/pg_password` (Docker secret) est lu par l'init Postgres pour
#     créer le user à la création du volume.
#   - `DATABASE_URL` ci-dessous embarque le même password pour que l'app
#     puisse se connecter. Garder les deux strictement cohérents.
#   - Si caractères spéciaux dans le password (ex: `+`, `/`, `=`), URL-encoder
#     dans DATABASE_URL (sinon erreur de parsing).

# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# Pour Docker, le backend bind sur 0.0.0.0 (configuré dans le Dockerfile aussi).
# BACKEND_PORT et BACKEND_HOST surchargeables si besoin.

# ─────────────────────────────────────────────────────────────────────────────
# Postgres (cohérent avec secrets/pg_user + secrets/pg_password)
# ─────────────────────────────────────────────────────────────────────────────
# Format : postgres://USER:PASSWORD@HOST:PORT/DB
# HOST = `postgres` (nom du service Docker dans nexus-internal)
DATABASE_URL=postgres://nexus:CHANGEME_PG_PASSWORD@postgres:5432/nexus

# ─────────────────────────────────────────────────────────────────────────────
# Redis (service `redis` dans nexus-internal)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─────────────────────────────────────────────────────────────────────────────
# JWT (générer 48+ bytes random aléatoirement, jamais réutiliser le dev)
# ─────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGEME_64_chars_minimum_run_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGEME_64_chars_minimum_run_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─────────────────────────────────────────────────────────────────────────────
# WebSocket
# ─────────────────────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_MAX=10

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (optionnel — détection d'intention dans messages)
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5

# ─────────────────────────────────────────────────────────────────────────────
# URL publique (pour les liens partagés des killer features)
# ─────────────────────────────────────────────────────────────────────────────
WEB_BASE_URL=https://app.nexusapp.chat

# ─────────────────────────────────────────────────────────────────────────────
# Web Push / VAPID (MAN-142, phase 1 de MAN-24 — notifications push PWA)
# ─────────────────────────────────────────────────────────────────────────────
# Paire générée UNE fois puis conservée telle quelle : la régénérer invalide
# TOUS les abonnements existants (les navigateurs sont abonnés à la clé publique).
#   pnpm --filter @nexus/backend exec web-push generate-vapid-keys
# Sans ces deux variables le backend démarre normalement mais N'ENVOIE AUCUN
# push (warning au premier essai). VAPID_PRIVATE_KEY ne quitte jamais le serveur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
