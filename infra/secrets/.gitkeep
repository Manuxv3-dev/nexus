# Dossier prévu pour héberger les Docker secrets sur le VPS :
#   /opt/nexus/secrets/pg_user
#   /opt/nexus/secrets/pg_password
#
# ⚠️ NE JAMAIS COMMITER de fichiers réels dans ce dossier — uniquement
# ce .gitkeep pour préserver la structure dans git.
#
# Sur le VPS, créer les fichiers :
#   echo -n "nexus" > /opt/nexus/secrets/pg_user
#   openssl rand -base64 32 > /opt/nexus/secrets/pg_password
#   chmod 0600 /opt/nexus/secrets/*
#   chown nexus:nexus /opt/nexus/secrets/*
